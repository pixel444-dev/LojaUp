{
  "name": "lojaup",
  "productName": "LojaUp",
  "version": "1.0.0",
  "description": "Sistema de gestão para lojas de roupas — vendas, estoque, compras, financeiro e crediário.",
  "main": "electron/main.js",
  "author": "pixel444-dev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env LOJAUP_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "br.com.lojaup.app",
    "productName": "LojaUp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LojaUp"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@45.1.0": true
  }
}
